{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inu-ai-shop",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "inu-ai-shop" }]
}
